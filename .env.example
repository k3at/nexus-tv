# ---------------------------------------------------------------------------
# NEXUS//TV configuration  (copy to .env and edit)
# ---------------------------------------------------------------------------

# Server
PORT=8080
HOST=0.0.0.0
SITE_NAME=NEXUS//TV
SITE_TAGLINE=Live channel intelligence grid

# Secrets (generated automatically if left empty)
SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=

# Access control
#   true  -> visitors must enter a code created by the admin
#   false -> open access (admin can toggle this live from the Admin panel)
REQUIRE_LOGIN=true
# Allow visitors to add their own stream URLs (search & test any channel)
ALLOW_CUSTOM_STREAMS=true

# Persistent storage (pick one)
# 1) local disk (default) - DATA_DIR=/var/data for hosts with a mounted volume
DATA_DIR=./data
# 2) Upstash Redis (free tier) - persistent on ephemeral hosts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 3) GitHub repo KV (free, no signup) - persists codes/settings between restarts
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_KV_PATH=data/kv.json

# Stream health checker
PROBE_TIMEOUT_MS=6000
PROBE_CONCURRENCY=10
SCAN_RATE=5
STATUS_TTL_MS=900000

# Proxy
PROXY_TIMEOUT_MS=20000
ALLOW_PRIVATE_STREAMS=false

# Catalogue source (public, MIT licensed iptv-org data)
CATALOG_API_BASE=https://iptv-org.github.io/api
CATALOG_REFRESH_MS=21600000
